      "get": {
        "operationId": "TicketIssueController_operation",
        "parameters": [
          {
            "name": "clientOperationId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenantId",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "eventId",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "command",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"

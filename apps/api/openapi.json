  "info": {
    "title": "Ticket API — D2 issue",
    "description": "Identity plus redemption issue (PostgreSQL quota/outbox). Redis does not decide quota.",
    "version": "0.2.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "api"
            ]
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "issuer": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "required": [
          "userId",
          "issuer",
          "subject",
          "email",
          "emailVerified"
        ]
      },
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "code",
          "message",
          "requestId",
          "retryable"
        ]
      },
      "RedeemBodyDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "formVersion": {
            "type": "string"
          },
          "termsVersion": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ]
      },
      "RedeemResponseDto": {
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          },
          "credentialVersion": {
            "type": "number"
          },
          "replayed": {
            "type": "boolean"
          }
        },
        "required": [
          "ticketId",
          "requestId",
          "operationId",
          "eventId",
          "ticketTypeId",
          "sourceId",
          "state",
          "credentialVersion",
          "replayed"
        ]
      },
      "TicketSummaryDto": {
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string"
          },
          "credentialVersion": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "ticketId",
          "tenantId",
          "eventId",
          "ticketTypeId",
          "sourceId",
          "state",
          "credentialVersion",
          "createdAt"
        ]
      },
      "MeTicketsDto": {
        "type": "object",
        "properties": {
          "tickets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TicketSummaryDto"
            }
          }
        },
        "required": [
          "tickets"
        ]
      },
      "TenantBodyDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "tenantId"
        ]
      },
      "SessionResponseDto": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE"
            ]
          }
        },
        "required": [
          "sessionId",
          "eventId",
          "status"
        ]
      },
      "RevokeSessionBodyDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "staffSessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "tenantId",
          "staffSessionId"
        ]
      },
      "ReserveBodyDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "staffSessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "tenantId",
          "ticketId",
          "staffSessionId"
        ]
      },
      "ReserveResponseDto": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string"
          },
          "ticketId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "reservationId",
          "token",
          "expiresAt",
          "ticketId"
        ]
      },
      "ConfirmBodyDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "token": {
            "type": "string"
          },
          "staffSessionId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "tenantId",
          "token",
          "staffSessionId"
        ]
      },
      "ConfirmResponseDto": {
        "type": "object",
        "properties": {
          "checkinId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "USED"
            ]
          }
        },
        "required": [
          "checkinId",
          "ticketId",
          "reservationId",
          "state"
        ]
      },
      "ReasonBodyDto": {
        "type": "object",
        "properties": {
          "tenantId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "tenantId",
          "reason"
        ]
      },
      "ConfigBodyDto": {
        "type": "object",
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": true
          },
          "schemaVersion": {
            "type": "number"
          }
        },
        "required": [
          "payload"
        ]
      },
      "PublishBodyDto": {
        "type": "object",
        "properties": {
          "expectedVersion": {
            "type": "number"
          }
        },
        "required": [
          "expectedVersion"
        ]
      },
      "ImportBodyDto": {
        "type": "object",
        "properties": {
          "codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "eventQuota": {
            "type": "number"
          }
        },
        "required": [
          "codes"
        ]
      }
    }
  }
}

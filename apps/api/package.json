{
  "name": "@ticket/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm build && node --test test/*.test.cjs",
    "dev": "pnpm build && node --watch dist/main.js",
    "start": "node dist/main.js",
    "openapi": "pnpm build && node dist/openapi.js"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@ticket/backend": "workspace:*",
    "@ticket/contracts": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "jose": "5.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}

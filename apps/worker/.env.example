# Worker documentation placeholders — copy to local .env; never commit secrets.
# See docs/ops/ENV-MANIFEST.md and root .env.example.
NODE_ENV=development

DATABASE_URL=postgresql://ticket_dev:local_dev_only@127.0.0.1:55432/ticket_solution

# ADR-17: direct PG outbox poll (not BullMQ)
OUTBOX_POLL_MS=2000
OUTBOX_CLAIM_LIMIT=10
OUTBOX_LEASE_SECONDS=30
WORKER_LEASE_OWNER=local-worker-1

# SMTP → Mailpit in Compose; production must set real SMTP_URL (no noop fallback)
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=tickets@localhost

# MinIO (when export/asset/import adapters enabled)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ASSETS=vemoki-assets
MINIO_BUCKET_EXPORTS=vemoki-exports
MINIO_BUCKET_IMPORTS=vemoki-imports
MINIO_REGION=us-east-1

# APNs — leave APNS_ENABLED=false until .p8 is mounted locally
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=BLUA62D52G
APNS_BUNDLE_ID=com.hangndat.ticket
# APNS_KEY_PATH=
APNS_PRODUCTION=false

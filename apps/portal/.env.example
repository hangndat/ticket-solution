# Documentation only. Never commit real credentials.
API_BASE_URL=http://127.0.0.1:3100
WEB_PUBLIC_ORIGIN=http://127.0.0.1:3013
OIDC_ISSUER=http://127.0.0.1:8080/realms/ticket
OIDC_CLIENT_ID=ticket-admin-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:3013/api/auth/callback
OIDC_AUDIENCE=ticket-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/ticket/protocol/openid-connect/certs
# No offline_access — Keycloak returns not_allowed unless client/user explicitly allows offline tokens (see PROD-LAUNCH UAT B02).
OIDC_SCOPES=openid profile email
AUTH_COOKIE_SECURE=false
# Set true with TLS in a separately authorized production deployment.
PRODUCT_ORIGIN=https://app.vemoki.com
PORTAL_ORIGIN=https://portal.vemoki.com
MARKETING_ORIGIN=https://vemoki.com
# Dual-run banner (ADR-20 §8 / #438). Default on when PRODUCT_ORIGIN set; 0 to hide.
# PORTAL_DUAL_RUN_BANNER=1

PLATFORM_OIDC_CLIENT_ID=ticket-platform-web
PLATFORM_OIDC_CLIENT_SECRET=
PLATFORM_OIDC_REDIRECT_URI=http://127.0.0.1:3013/api/auth/platform/callback
PLATFORM_OIDC_AUDIENCE=ticket-platform-api
PLATFORM_OIDC_REQUIRED_ACR=2
PLATFORM_OIDC_JWKS_URL=http://127.0.0.1:8080/realms/ticket/protocol/openid-connect/certs
# Opaque ACR string must match token claim exactly (not numeric >=).
PLATFORM_MFA_AUTH_TIME_MAX_SECONDS=900

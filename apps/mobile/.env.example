# Local only — copy to apps/mobile/.env or repo-root .env. Never commit real keys.
# Expo inlines EXPO_PUBLIC_* at bundle time.

# Clerk publishable key (pk_test_… / pk_live_…). Empty → fail-closed UI; no stub verified user.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Nest API base URL for GET /v1/me (short-lived bearer). Example local default:
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Expo inlines EXPO_PUBLIC_* at bundle time.
# Self-hosted Keycloak public client + PKCE. Empty → fail-closed UI; no stub verified user.

EXPO_PUBLIC_OIDC_ISSUER=http://127.0.0.1:8080/realms/ticket
EXPO_PUBLIC_OIDC_CLIENT_ID=ticket-mobile
EXPO_PUBLIC_OIDC_SCOPES=openid profile email

# Nest API base (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

# Tenant UUID for GET /v1/me/tickets?tenantId= (required by API; empty → no wallet fetch)
EXPO_PUBLIC_TENANT_ID=

# Event UUID for a bare ticket-id scan. Display QR already includes eventId.
EXPO_PUBLIC_EVENT_ID=

# Push provider name. Leave empty: the app says push is not configured and
# never reports a notification as delivered. Set to `apns` to enable native
# APNs device-token registration UI (getDevicePushTokenAsync only — never
# Expo Push Service). Do not put APNs auth keys (.p8) here; those belong to
# the self-hosted worker, not this app.
EXPO_PUBLIC_PUSH_PROVIDER=

# APNs entitlement / API environment. Default (empty) → development entitlement
# + API environment `sandbox`. Set to `production` before local Release/TestFlight
# prebuild so `aps-environment` is production (also accepted: APS_ENVIRONMENT /
# APP_VARIANT). Never put .p8 keys here.
EXPO_PUBLIC_APS_ENVIRONMENT=

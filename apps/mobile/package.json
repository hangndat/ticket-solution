{
  "name": "@ticket/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/ui": "58.0.19",
    "@ticket/contracts": "workspace:*",
    "expo": "58.0.12",
    "expo-auth-session": "58.0.12",
    "expo-camera": "~58.0.10",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.6",
    "expo-font": "58.0.8",
    "expo-linking": "58.0.13",
    "expo-notifications": "58.1.5",
    "expo-router": "58.0.21",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.9",
    "expo-status-bar": "58.0.3",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-expo": "58.0.4",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "dev": "expo start --ios --port 8083",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --experimental-strip-types --test src/identity/*.test.ts src/data/*.test.ts src/brand/*.test.ts src/tickets/*.test.ts src/gate/*.test.ts src/redeem/*.test.ts src/lib/*.test.ts src/navigation/*.test.ts src/links/*.test.ts src/push/*.test.ts src/account-deletion/*.test.ts src/published/*.test.ts src/theme/*.test.ts src/components/*.test.ts src/attendee/*.test.ts src/screens/*.test.ts",
    "test:durable-integration": "node --import ./scripts/durable-test-loader.mjs --test src/gate/durable-production.integration.test.mjs",
    "build": "expo export --platform ios --output-dir dist",
    "sync-ios-build": "node scripts/sync-ios-build-number.mjs"
  },
  "private": true,
  "type": "module"
}

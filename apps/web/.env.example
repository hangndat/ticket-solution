# Self-hosted Keycloak OIDC (BFF). Never commit real secrets.
# Both client id + secret required or UI/API fail closed.

OIDC_ISSUER=http://127.0.0.1:8080/realms/ticket
OIDC_CLIENT_ID=ticket-web
OIDC_CLIENT_SECRET=dev-web-secret-change-me
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
OIDC_SCOPES=openid profile email

# Nest API upstream for BFF
API_BASE_URL=http://127.0.0.1:3001

# Cookie flags: leave unset for local http; set AUTH_COOKIE_SECURE=true behind TLS
# AUTH_COOKIE_SECURE=true

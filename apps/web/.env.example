# Self-hosted Keycloak OIDC (BFF). Never commit real secrets.
# Both client id + secret required or UI/API fail closed.

OIDC_ISSUER=http://127.0.0.1:8080/realms/ticket
OIDC_CLIENT_ID=ticket-web
OIDC_CLIENT_SECRET=dev-web-secret-change-me
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_AUDIENCE=ticket-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/ticket/protocol/openid-connect/certs
OIDC_SCOPES=openid profile email

# Platform operator OIDC (separate client/audience from attendee ticket-web).
# Fail closed when any PLATFORM_OIDC_* below is missing — no mock MFA.
# PLATFORM_OIDC_ISSUER defaults to OIDC_ISSUER when unset.
PLATFORM_OIDC_CLIENT_ID=ticket-platform-web
PLATFORM_OIDC_CLIENT_SECRET=dev-platform-secret-change-me
PLATFORM_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/platform/callback
PLATFORM_OIDC_AUDIENCE=ticket-platform-api
PLATFORM_OIDC_REQUIRED_ACR=vemoki-mfa
# PLATFORM_OIDC_SCOPES=openid profile email offline_access

# Canonical browser origin allowlist for CSRF (comma-separated). Prefer localhost over 127.0.0.1.
# After O13 cutover, product allowlist is https://app.vemoki.com (dual-run may include apex).
WEB_PUBLIC_ORIGIN=http://localhost:3000

# O13 host split (architect A1): marketing apex vs product app subdomain.
# Localhost stays product for `/`; set Host: vemoki.com (or open /marketing) for sales UAT.
PRODUCT_ORIGIN=http://localhost:3000
MARKETING_ORIGIN=http://localhost:3000
MARKETING_HOSTS=vemoki.com,www.vemoki.com

# ADR-20: staff home is portal. After staff OIDC on ticket-web, bounce here.
# Bookmark GET/HEAD /admin|/platform also redirect here. Never POST/BFF.
# PORTAL_ORIGIN=http://127.0.0.1:3013
# Prod (#502): PORTAL_ORIGIN=https://portal.vemoki.com


# Interest form durable JSONL (default: apps/web/.data/marketing-interest.jsonl when cwd=apps/web)
# MARKETING_INTEREST_PATH=/var/lib/vemoki/marketing-interest.jsonl
# Optional ops notify (email bridge / n8n / Slack). Persistence succeeds even if webhook fails.
# MARKETING_INTEREST_WEBHOOK_URL=https://hooks.example.internal/vemoki-interest
# MARKETING_INTEREST_WEBHOOK_SECRET=

# Nest API upstream for BFF
API_BASE_URL=http://127.0.0.1:3001

# Global single-code redeem on /redeem (no tenant/event query). Requires API SINGLE_CODE_RESOLVE_GLOBAL.
# NEXT_PUBLIC_SINGLE_CODE_RESOLVE=0

# Home public catalog entry tenants (comma-separated slugs). Defaults: mfest-demo,demo-studio (D9 seed).
# PUBLIC_HOME_TENANT_SLUGS=mfest-demo,demo-studio

# Cookie flags: leave unset for local http; set AUTH_COOKIE_SECURE=true behind TLS
# AUTH_COOKIE_SECURE=true

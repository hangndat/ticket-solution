# Self-hosted Keycloak OIDC (BFF). Never commit real secrets.
# Both client id + secret required or UI/API fail closed.

OIDC_ISSUER=http://127.0.0.1:8080/realms/ticket
OIDC_CLIENT_ID=ticket-web
OIDC_CLIENT_SECRET=dev-web-secret-change-me
OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
OIDC_SCOPES=openid profile email

# Platform operator OIDC (separate client/audience from attendee ticket-web).
# Fail closed when any PLATFORM_OIDC_* below is missing — no mock MFA.
# PLATFORM_OIDC_ISSUER defaults to OIDC_ISSUER when unset.
PLATFORM_OIDC_CLIENT_ID=ticket-platform
PLATFORM_OIDC_CLIENT_SECRET=dev-platform-secret-change-me
PLATFORM_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/platform/callback
PLATFORM_OIDC_AUDIENCE=ticket-platform-api
PLATFORM_OIDC_REQUIRED_ACR=vemoki-mfa
# PLATFORM_OIDC_SCOPES=openid profile email offline_access

# Canonical browser origin allowlist for CSRF (comma-separated). Prefer localhost over 127.0.0.1.
WEB_PUBLIC_ORIGIN=http://localhost:3000

# Nest API upstream for BFF
API_BASE_URL=http://127.0.0.1:3001

# Cookie flags: leave unset for local http; set AUTH_COOKIE_SECURE=true behind TLS
# AUTH_COOKIE_SECURE=true

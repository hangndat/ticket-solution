# Documentation only — copy to apps/web/.env.local for local POC.
# Never commit real Clerk secrets or publishable keys with production data.

# Clerk (required for identity POC). Both must be set or UI fails closed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk URLs (defaults work for most Apps)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/auth

# Nest API base for same-origin BFF proxy (GET /api/bff/me → GET /v1/me)
API_BASE_URL=http://127.0.0.1:3001

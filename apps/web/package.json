{
  "name": "@ticket/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typegen": "node -e \"require('fs').mkdirSync(require('path').join('.next','types'),{recursive:true})\" && next typegen",
    "typecheck": "pnpm run typegen && tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:routes": "node --test tests/routes.integration.mjs tests/legacy-cascade.postbuild.mjs tests/staff-auth.integration.mjs",
    "uat:cascade": "node tests/uat-cascade.mjs"
  },
  "dependencies": {
    "@ticket/contracts": "workspace:*",
    "@ticket/ui": "workspace:*",
    "@ticket/web-session": "workspace:*",
    "jose": "5.10.0",
    "motion": "12.23.24",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}

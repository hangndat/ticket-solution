{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ticket/backend#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "src/generated/**"]
    },
    "@ticket/backend#typecheck": {
      "dependsOn": ["build"]
    },
    "@ticket/backend#test": {
      "dependsOn": ["build"]
    },
    "@ticket/api#typecheck": {
      "dependsOn": ["build"]
    },
    "@ticket/api#test": {
      "dependsOn": ["build"]
    },
    "@ticket/worker#typecheck": {
      "dependsOn": ["build"]
    },
    "@ticket/worker#test": {
      "dependsOn": ["build"]
    }
  }
}

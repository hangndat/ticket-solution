generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id           String       @id @db.Uuid
  slug         String       @unique
  name         String
  events       Event[]
  memberships  Membership[]

  @@map("tenants")
}

model Event {
  tenantId         String            @map("tenant_id") @db.Uuid
  id               String            @db.Uuid
  slug             String
  name             String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  eventAssignments EventAssignment[]

  @@id([tenantId, id])
  @@unique([tenantId, slug])
  @@map("events")
}

/// Global OIDC identity mapping. Not tenant-scoped — never query via withTenant.
model User {
  id            String       @id @db.Uuid
  issuer        String
  subject       String
  email         String?
  emailVerified Boolean      @default(false) @map("email_verified")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships   Membership[]

  @@unique([issuer, subject])
  @@map("users")
}

/// Staff/organizer tenant membership. Deny-by-default: inactive or revoked = no access.
model Membership {
  id               String            @id @db.Uuid
  tenantId         String            @map("tenant_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  role             String
  permissions      String[]          @default([])
  activatedAt      DateTime?         @map("activated_at") @db.Timestamptz(3)
  revokedAt        DateTime?         @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  eventAssignments EventAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("memberships")
}

/// Event-scoped staff assignment with permissions. Required when the route needs event scope.
model EventAssignment {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  eventId      String     @map("event_id") @db.Uuid
  membershipId String     @map("membership_id") @db.Uuid
  permissions  String[]   @default([])
  activatedAt  DateTime?  @map("activated_at") @db.Timestamptz(3)
  revokedAt    DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  event        Event      @relation(fields: [tenantId, eventId], references: [tenantId, id], onDelete: Restrict)
  membership   Membership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@unique([tenantId, eventId, membershipId])
  @@index([membershipId])
  @@map("event_assignments")
}

generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
model Tenant {
  id String @id @db.Uuid
  slug String @unique
  name String
  events Event[]
  @@map("tenants")
}
model Event {
  tenantId String @map("tenant_id") @db.Uuid
  id String @db.Uuid
  slug String
  name String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@id([tenantId, id])
  @@unique([tenantId, slug])
  @@map("events")
}

{
  "name": "@ticket/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "pnpm build && node --test test/env.test.cjs",
    "generate": "prisma generate",
    "test:db": "pnpm build && node --test test/rls.test.cjs",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "prisma": "7.10.1",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.71.2"
  }
}

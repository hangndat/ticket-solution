# Documentation only. Supply separate least-privilege credentials via environment.
DATABASE_URL=postgresql://runtime_login:REPLACE_ME@127.0.0.1:5432/ticket_dev
MIGRATION_DATABASE_URL=postgresql://migration_login:REPLACE_ME@127.0.0.1:5432/ticket_dev

# OIDC / Clerk — verify JWT via JWKS in Nest; never commit real secrets.
OIDC_PROVIDER=clerk
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

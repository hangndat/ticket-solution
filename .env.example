# Development only. Override ports per worktree. Never commit real secrets.
COMPOSE_PROJECT_NAME=ticket-solution
POSTGRES_PORT=55432
POSTGRES_DB=ticket_solution
POSTGRES_USER=ticket_dev
POSTGRES_PASSWORD=local_dev_only
REDIS_PORT=56379

# Keycloak (self-host OIDC) — Compose binds 127.0.0.1:8080
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO / Mailpit
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# D1 OIDC (Keycloak) — documentation placeholders. Real secrets stay in local .env.
OIDC_PROVIDER=keycloak
OIDC_ISSUER=http://127.0.0.1:8080/realms/ticket
OIDC_AUDIENCE=ticket-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/ticket/protocol/openid-connect/certs

# See apps/web/.env.example and apps/mobile/.env.example for client credentials.

# D2 issue / outbox (documentation placeholders — override in local .env only)
CODE_HMAC_PEPPER=local-dev-code-pepper-change-me
CODE_HMAC_VERSION=1
TICKET_CREDENTIAL_KEY=local-dev-credential-key
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=tickets@localhost
OUTBOX_POLL_MS=2000

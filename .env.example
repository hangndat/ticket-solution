# Development only. Override ports per worktree. Never commit real secrets.
# Full name catalog: docs/ops/ENV-MANIFEST.md
COMPOSE_PROJECT_NAME=ticket-solution
POSTGRES_PORT=55432
POSTGRES_DB=ticket_solution
POSTGRES_USER=ticket_dev
POSTGRES_PASSWORD=local_dev_only
REDIS_PORT=56379

# Keycloak (self-host OIDC) — Compose binds 127.0.0.1:8080
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO / Mailpit (ADR-14 / ADR-13) — placeholders only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ASSETS=vemoki-assets
MINIO_BUCKET_EXPORTS=vemoki-exports
MINIO_BUCKET_IMPORTS=vemoki-imports
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# D1 OIDC (Keycloak) — documentation placeholders. Real secrets stay in local .env.
OIDC_PROVIDER=keycloak
OIDC_ISSUER=http://127.0.0.1:8080/realms/ticket
OIDC_AUDIENCE=ticket-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/ticket/protocol/openid-connect/certs
# Platform operator audience (M12) — BE verifier riêng; không cấp cho ticket-mobile
OIDC_PLATFORM_AUDIENCE=ticket-platform-api
PLATFORM_OIDC_AUDIENCE=ticket-platform-api
PLATFORM_INVITE_TTL_SECONDS=172800
PLATFORM_SUPPORT_TTL_MAX_SECONDS=3600
PLATFORM_MFA_AUTH_TIME_MAX_SECONDS=900
PLATFORM_MFA_ACR_VALUES=2
PLATFORM_SECURITY_CONFIG=./infra/platform/security-config.json
# Production: PLATFORM_ENV=production → thiếu security-config fail closed
# PLATFORM_ENV=development

# Deploy init-db platform pool password (documentation placeholder)
# TICKET_PLATFORM_APP_PASSWORD=local_platform_only_change_me

# See apps/web/.env.example and apps/mobile/.env.example for client credentials.

# D2 issue / outbox (documentation placeholders — override in local .env only)
CODE_HMAC_PEPPER=local-dev-code-pepper-change-me
CODE_HMAC_VERSION=1
# Optional JSON map of legacy pepper versions for global resolve aliases, e.g. {"1":"same-as-pepper"}
# CODE_HMAC_LEGACY_PEPPERS=
# CODE_ROUTING_FP_SECRET=
# REDEMPTION_RESOLVE_TOKEN_SECRET=
# SINGLE_CODE_RESOLVE_GLOBAL=0
TICKET_CREDENTIAL_KEY=local-dev-credential-key
SMTP_URL=smtp://127.0.0.1:1025
# Production: smtps://user:pass@postal:465 or smtp+tls://user:pass@postal:587 — never noop
# EMAIL_ALLOW_NOOP=1  # non-production only; ignored when NODE_ENV=production
SMTP_FROM=tickets@localhost
PUBLIC_WEB_BASE_URL=http://127.0.0.1:3000
# Published event raster URLs in API responses (defaults to http://127.0.0.1:3100)
# PUBLISHED_ASSET_PUBLIC_BASE=http://127.0.0.1:3100

# Worker / outbox poll (ADR-17 — PG direct, not BullMQ)
OUTBOX_POLL_MS=2000
OUTBOX_CLAIM_LIMIT=10
OUTBOX_LEASE_SECONDS=30
WORKER_LEASE_OWNER=local-worker-1

# APNs direct (ADR-12) — fail-closed when enabled without key; never commit .p8
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=BLUA62D52G
APNS_BUNDLE_ID=com.hangndat.ticket
# Prefer file path (AuthKey). Inline APNS_KEY_P8 / APNS_PRIVATE_KEY also accepted.
# APNS_KEY_PATH=/absolute/path/to/AuthKey_XXX.p8
APNS_PRODUCTION=false

# Tenant host mapping (O07 / TD §12.1) — allowlist; do not trust raw Host
PLATFORM_ROOT_DOMAIN=vemoki.com
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
# TENANT_HOST_ALLOWLIST=./infra/platform/tenant-host-allowlist.example.json

# Dev default export link TTL (seconds). Not an O06 retention decision.
EXPORT_TTL_SECONDS=86400
# Legacy single-bucket alias used by some D4 export paths (prefer MINIO_BUCKET_EXPORTS)
# MINIO_BUCKET=vemoki-exports

# D13: API + worker share the same denylist keyring (documentation only).
# JSON array of {"keyId":"...","secretBase64":"..."}; each secret decodes to >=32 random bytes.
# Generate/store real keys outside Git. Keep old keys until their last digest expires.
# Digest TTL: 48h after confirmed IdP deletion; hourly worker purge. Missing required key fails closed.
ACCOUNT_DELETION_TOMBSTONE_KEYRING_JSON=[]
ACCOUNT_DELETION_TOMBSTONE_CURRENT_KEY_ID=

# D13: worker-only erasure client; never pass this secret to API/web/mobile.
# Enable only after trusted issuer->Keycloak UUID mapping and least-privilege client are verified.
# Disabled/unconfigured erasure must keep requests pending, never claim PG-only completion.
KEYCLOAK_ERASURE_ENABLED=0
KEYCLOAK_BASE_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=ticket
KEYCLOAK_ERASURE_CLIENT_ID=vemoki-erasure
KEYCLOAK_ERASURE_CLIENT_SECRET=

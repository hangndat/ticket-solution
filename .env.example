# Development only. Override ports per worktree. Never commit real secrets.
COMPOSE_PROJECT_NAME=ticket-solution
POSTGRES_PORT=55432
POSTGRES_DB=ticket_solution
POSTGRES_USER=ticket_dev
POSTGRES_PASSWORD=local_dev_only
REDIS_PORT=56379

# D1 OIDC (Clerk) — documentation placeholders only. Real keys stay in local .env / Secrets.
OIDC_PROVIDER=clerk
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
# Mobile Expo public env — see apps/mobile/.env.example (never commit pk_live / secrets).
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

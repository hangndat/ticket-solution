# Development only. Override ports per worktree. Never commit real secrets.
# Full name catalog: docs/ops/ENV-MANIFEST.md
COMPOSE_PROJECT_NAME=ticket-solution
POSTGRES_PORT=55432
POSTGRES_DB=ticket_solution
POSTGRES_USER=ticket_dev
POSTGRES_PASSWORD=local_dev_only
REDIS_PORT=56379

# Keycloak (self-host OIDC) — Compose binds 127.0.0.1:8080
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO / Mailpit (ADR-14 / ADR-13) — placeholders only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_ASSETS=vemoki-assets
MINIO_BUCKET_EXPORTS=vemoki-exports
MINIO_BUCKET_IMPORTS=vemoki-imports
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# D1 OIDC (Keycloak) — documentation placeholders. Real secrets stay in local .env.
OIDC_PROVIDER=keycloak
OIDC_ISSUER=http://127.0.0.1:8080/realms/ticket
OIDC_AUDIENCE=ticket-api
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/ticket/protocol/openid-connect/certs

# See apps/web/.env.example and apps/mobile/.env.example for client credentials.

# D2 issue / outbox (documentation placeholders — override in local .env only)
CODE_HMAC_PEPPER=local-dev-code-pepper-change-me
CODE_HMAC_VERSION=1
TICKET_CREDENTIAL_KEY=local-dev-credential-key
SMTP_URL=smtp://127.0.0.1:1025
SMTP_FROM=tickets@localhost

# Worker / outbox poll (ADR-17 — PG direct, not BullMQ)
OUTBOX_POLL_MS=2000
OUTBOX_CLAIM_LIMIT=10
OUTBOX_LEASE_SECONDS=30
WORKER_LEASE_OWNER=local-worker-1

# APNs direct (ADR-12) — fail-closed when enabled without key; never commit .p8
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=BLUA62D52G
APNS_BUNDLE_ID=com.hangndat.ticket
# APNS_KEY_PATH=/absolute/path/to/AuthKey_XXX.p8
APNS_PRODUCTION=false

# Tenant host mapping (O07 / TD §12.1) — allowlist; do not trust raw Host
PLATFORM_ROOT_DOMAIN=vemoki.com
PUBLIC_WEB_ORIGIN=http://127.0.0.1:3000
# TENANT_HOST_ALLOWLIST=./infra/platform/tenant-host-allowlist.example.json

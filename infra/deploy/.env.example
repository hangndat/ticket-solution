# VPS documentation placeholders ONLY — copy to /opt/vemoki/.env (mode 600).
# Never commit real secrets, .p8 keys, or production passwords.
# Full catalog: docs/ops/ENV-MANIFEST.md

COMPOSE_PROJECT_NAME=vemoki
POSTGRES_USER=vemoki
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=ticket_solution
TICKET_APP_PASSWORD=change_me_ticket_app
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin
OIDC_CLIENT_SECRET=change_me_oidc_web_secret
CODE_HMAC_PEPPER=change_me_hmac_pepper_32chars_min
TICKET_CREDENTIAL_KEY=change_me_credential_key_16plus
# Platform-wide global redeem lookup. Keep 0 until code_routing backfill
# reports AMBIGUOUS=0. Prod seed codes (docs/demo/PROD-SEED-DATASET.md) need 1.
SINGLE_CODE_RESOLVE_GLOBAL=0
# Prod import: no smtpServer (Porkbun via scripts/keycloak-prod-smtp-apply.sh). Dev: infra/keycloak/realm-ticket.json + Mailpit.
REALM_FILE=/opt/vemoki/realm-ticket.prod.json

# O13: product origin is app.; apex vemoki.com is marketing-only after cutover.
PUBLIC_WEB_BASE_URL=https://app.vemoki.com
PUBLIC_WEB_ORIGIN=https://app.vemoki.com
WEB_PUBLIC_ORIGIN=https://app.vemoki.com
OIDC_REDIRECT_URI=https://app.vemoki.com/api/auth/callback
PRODUCT_ORIGIN=https://app.vemoki.com
MARKETING_ORIGIN=https://vemoki.com
MARKETING_HOSTS=vemoki.com,www.vemoki.com

# Portal cutover (ADR-20 / Issue #502) — dual-run ON only after portal DNS/TLS/nginx healthy.
PORTAL_ORIGIN=https://portal.vemoki.com
PORTAL_WEB_PUBLIC_ORIGIN=https://portal.vemoki.com
PORTAL_OIDC_REDIRECT_URI=https://portal.vemoki.com/api/auth/callback
PORTAL_PLATFORM_OIDC_REDIRECT_URI=https://portal.vemoki.com/api/auth/platform/callback
# Keycloak client secret for ticket-admin-web (NOT ticket-web OIDC_CLIENT_SECRET).
OIDC_ADMIN_CLIENT_SECRET=change_me_oidc_admin_secret
OIDC_AUDIENCE=ticket-api
OIDC_JWKS_URL=https://auth.vemoki.com/realms/ticket/protocol/openid-connect/certs
# Dual-run: set PORTAL_ADMIN_REDIRECT=1 only after portal login smoke; Gate stays on app.
PORTAL_ADMIN_REDIRECT=0
PORTAL_DUAL_RUN_BANNER=1
# Must match Keycloak clientId ticket-platform-web (not ticket-platform).
PLATFORM_OIDC_CLIENT_ID=ticket-platform-web
PLATFORM_OIDC_REDIRECT_URI=https://app.vemoki.com/api/auth/platform/callback
PLATFORM_OIDC_AUDIENCE=ticket-platform-api
PLATFORM_OIDC_REQUIRED_ACR=vemoki-mfa
# PLATFORM_OIDC_CLIENT_SECRET=  # set in /opt/vemoki/.env only
SMTP_URL=smtp://noreply%40vemoki.com:change_me_smtp_password@smtp.porkbun.com:587
SMTP_FROM=noreply@vemoki.com

# MinIO / S3-compatible (ADR-14) — durable volume minio_data
MINIO_ROOT_USER=vemoki_minio
MINIO_ROOT_PASSWORD=change_me_minio_root
# App credentials (may equal root for bootstrap; prefer dedicated key later)
MINIO_ACCESS_KEY=vemoki_minio
MINIO_SECRET_KEY=change_me_minio_root
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET_ASSETS=vemoki-assets
MINIO_BUCKET_EXPORTS=vemoki-exports
MINIO_BUCKET_IMPORTS=vemoki-imports
EXPORT_TTL_SECONDS=86400

# APNs direct (ADR-12) — leave disabled until AuthKey.p8 is on the host
APNS_ENABLED=false
APNS_KEY_ID=
APNS_TEAM_ID=BLUA62D52G
APNS_BUNDLE_ID=com.hangndat.ticket
APNS_KEY_PATH=/run/secrets/apns/AuthKey.p8
APNS_PRODUCTION=true

# D13: API + worker share the same denylist keyring (documentation only).
# JSON array of {"keyId":"...","secretBase64":"..."}; each secret decodes to >=32 random bytes.
# Generate/store real keys outside Git. Keep old keys until their last digest expires.
# Digest TTL: 48h after confirmed IdP deletion; hourly worker purge. Missing required key fails closed.
ACCOUNT_DELETION_TOMBSTONE_KEYRING_JSON=[]
ACCOUNT_DELETION_TOMBSTONE_CURRENT_KEY_ID=

# D13: worker-only erasure client; never pass this secret to API/web/mobile.
# Enable only after trusted issuer->Keycloak UUID mapping and least-privilege client are verified.
# Disabled/unconfigured erasure must keep requests pending, never claim PG-only completion.
KEYCLOAK_ERASURE_ENABLED=0
KEYCLOAK_BASE_URL=https://auth.vemoki.com
KEYCLOAK_REALM=ticket
KEYCLOAK_ERASURE_CLIENT_ID=vemoki-erasure
KEYCLOAK_ERASURE_CLIENT_SECRET=

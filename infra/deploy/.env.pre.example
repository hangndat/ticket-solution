# Pre-environment placeholders — copy to /opt/vemoki-pre/.env (mode 600). Never commit real values.
# Stack: docker compose -f compose.yaml -f compose.pre.yaml --env-file /opt/vemoki-pre/.env -p vemoki-pre

COMPOSE_PROJECT_NAME=vemoki-pre
VEMOKI_SRC_ROOT=/opt/vemoki-pre/src
REALM_FILE=/opt/vemoki-pre/realm-ticket.pre.json

# Edge docker network aliases (must match infra/deploy/nginx-pre.snippet.conf upstream names)
VEMOKI_EDGE_WEB_ALIAS=vemoki-pre-web
VEMOKI_EDGE_API_ALIAS=vemoki-pre-api
VEMOKI_EDGE_KEYCLOAK_ALIAS=vemoki-pre-keycloak
VEMOKI_EDGE_PORTAL_ALIAS=vemoki-pre-portal

POSTGRES_USER=vemoki_pre
POSTGRES_PASSWORD=change_me_postgres_pre
POSTGRES_DB=ticket_solution_pre
TICKET_APP_PASSWORD=change_me_ticket_app_pre
KEYCLOAK_DB_PASSWORD=change_me_keycloak_db_pre
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin_pre

OIDC_CLIENT_SECRET=change_me_oidc_web_secret_pre
OIDC_ADMIN_CLIENT_SECRET=change_me_oidc_admin_secret_pre
PLATFORM_OIDC_CLIENT_SECRET=change_me_oidc_platform_secret_pre
CODE_HMAC_PEPPER=change_me_hmac_pepper_pre_32chars_min
TICKET_CREDENTIAL_KEY=change_me_credential_key_pre_16plus

# IdP public hostname (Keycloak + extra_hosts for BFF token exchange)
KC_HOSTNAME=https://pre-auth.vemoki.com
OIDC_HOST=pre-auth.vemoki.com
OIDC_ISSUER=https://pre-auth.vemoki.com/realms/ticket
OIDC_JWKS_URL=https://pre-auth.vemoki.com/realms/ticket/protocol/openid-connect/certs
PLATFORM_OIDC_JWKS_URL=https://pre-auth.vemoki.com/realms/ticket/protocol/openid-connect/certs
OIDC_AUDIENCE=ticket-api

# O13 mapping: pre = marketing apex, pre-app = product web
PUBLIC_WEB_BASE_URL=https://pre-app.vemoki.com
PUBLIC_WEB_ORIGIN=https://pre-app.vemoki.com
WEB_PUBLIC_ORIGIN=https://pre-app.vemoki.com
OIDC_REDIRECT_URI=https://pre-app.vemoki.com/api/auth/callback
PRODUCT_ORIGIN=https://pre-app.vemoki.com
MARKETING_ORIGIN=https://pre.vemoki.com
MARKETING_HOSTS=pre.vemoki.com

PORTAL_ORIGIN=https://pre-portal.vemoki.com
PORTAL_WEB_PUBLIC_ORIGIN=https://pre-portal.vemoki.com
PORTAL_OIDC_REDIRECT_URI=https://pre-portal.vemoki.com/api/auth/callback
PORTAL_PLATFORM_OIDC_REDIRECT_URI=https://pre-portal.vemoki.com/api/auth/platform/callback
PLATFORM_OIDC_REDIRECT_URI=https://pre-app.vemoki.com/api/auth/platform/callback
PORTAL_ADMIN_REDIRECT=0
PORTAL_DUAL_RUN_BANNER=0

# Worker mail: Mailpit only (no internet SMTP)
SMTP_URL=smtp://mailpit:1025
SMTP_FROM=noreply@pre.vemoki.com

KEYCLOAK_ERASURE_ENABLED=0
KEYCLOAK_BASE_URL=https://pre-auth.vemoki.com
KEYCLOAK_REALM=ticket

MINIO_ROOT_USER=vemoki_pre_minio
MINIO_ROOT_PASSWORD=change_me_minio_root_pre
MINIO_ACCESS_KEY=vemoki_pre_minio
MINIO_SECRET_KEY=change_me_minio_root_pre
MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_BUCKET_ASSETS=vemoki-pre-assets
MINIO_BUCKET_EXPORTS=vemoki-pre-exports
MINIO_BUCKET_IMPORTS=vemoki-pre-imports
EXPORT_TTL_SECONDS=86400

APNS_ENABLED=false
ACCOUNT_DELETION_TOMBSTONE_KEYRING_JSON=[]
ACCOUNT_DELETION_TOMBSTONE_CURRENT_KEY_ID=

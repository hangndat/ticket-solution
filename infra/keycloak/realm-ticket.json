{
  "realm": "ticket",
  "displayName": "Vemoki",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "offline_access" },
      { "name": "uma_authorization" }
    ]
  },
  "clients": [
    {
      "clientId": "ticket-api",
      "name": "Vemoki API (resource / audience)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "ticket-web",
      "name": "Vemoki Web BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-web-secret-change-me",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://127.0.0.1:3000/api/auth/callback",
        "http://localhost:3000/api/auth/callback",
        "http://127.0.0.1:3010/api/auth/callback",
        "http://localhost:3010/api/auth/callback",
        "https://vemoki.com/api/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://localhost:3000",
        "http://127.0.0.1:3010",
        "http://localhost:3010",
        "https://vemoki.com"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-ticket-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ticket-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "ticket-mobile",
      "name": "Vemoki iOS (public + PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "vemoki://oauth/callback",
        "exp://127.0.0.1:8081/--/oauth",
        "exp://localhost:8081/--/oauth",
        "exp://127.0.0.1:8083/--/oauth",
        "exp://localhost:8083/--/oauth",
        "exp://192.168.86.8:8083/--/oauth",
        "exp://192.168.86.8:8083"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-ticket-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ticket-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "attendee@example.com",
      "email": "attendee@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Attendee",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "attendee-demo",
          "temporary": false
        }
      ]
    },
    {
      "username": "staff@example.com",
      "email": "staff@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Staff",
      "lastName": "Demo",
      "credentials": [
        {
          "type": "password",
          "value": "staff-demo",
          "temporary": false
        }
      ]
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@vemoki.com",
    "fromDisplayName": "Vemoki",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  }
}

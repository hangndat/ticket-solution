{
  "name": "ticket-solution",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "pnpm --filter @ticket/contracts --filter @ticket/backend build && turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "uat:p4-oidc": "python3 scripts/uat-d1-p4-keycloak.py",
    "uat:web": "node scripts/web-uat.mjs",
    "test:rint-host": "node --test scripts/lib/tenant-host.test.mjs",
    "test:release": "python3 scripts/release-artifact.test.py",
    "test:load-context": "node --test scripts/load/scanner-context.test.mjs",
    "test:rint-outbox": "./scripts/rint-outbox-recovery.sh",
    "test:rint-stack": "./scripts/rint-stack-smoke.sh",
    "dev:web": "pnpm --filter @ticket/contracts build && pnpm --filter @ticket/web dev",
    "dev:api": "pnpm --filter @ticket/api... build && pnpm --filter @ticket/api dev",
    "dev:ios": "pnpm --filter @ticket/contracts build && pnpm --filter @ticket/mobile dev",
    "demo:seed": "./scripts/d9-demo-seed.sh",
    "demo:seed-smoke": "./scripts/d9-demo-seed-smoke.sh",
    "prod:media:build": "node scripts/prod-media-build.mjs --contact-sheet",
    "prod:media:verify": "node scripts/prod-media-verify.mjs",
    "check:prepush": "./scripts/pre-push-check.sh",
    "hooks:install": "./scripts/hooks-install.sh",
    "agent-metrics:opened": "node scripts/agent-role-monitor/cli.mjs record-opened",
    "agent-metrics:ingest": "node scripts/agent-role-monitor/cli.mjs ingest-settlement",
    "agent-metrics:join": "node scripts/agent-role-monitor/cli.mjs record-join",
    "agent-metrics:ingest-cursor-turn": "node scripts/agent-role-monitor/cli.mjs ingest-cursor-turn",
    "agent-metrics:rollup": "node scripts/agent-role-monitor/cli.mjs rollup",
    "agent-metrics:host-sample": "node scripts/agent-role-monitor/cli.mjs host-sample",
    "agent-metrics:test": "node --test scripts/agent-role-monitor/smoke.test.mjs",
    "agent:evidence": "node scripts/agent-evidence.mjs",
    "agent:guard": "node scripts/agent-workflow-guard.mjs",
    "agent:workflow": "node scripts/agent-workflow-run.mjs",
    "agent:cost:test": "node --test scripts/lib/agent-quota-policy.test.mjs scripts/orca-spawn-model-preflight.test.mjs scripts/orca-cost-wave-evidence.test.mjs scripts/agent-workflow-run.test.mjs",
    "agent:review-publish": "node scripts/agent-review-publish.mjs",
    "agent:telemetry": "node scripts/agent-role-monitor/telemetry.mjs",
    "agent:workflow:test": "node --test scripts/agent-evidence.test.mjs scripts/agent-workflow-guard.test.mjs scripts/agent-workflow-run.test.mjs scripts/agent-review-publish.test.mjs scripts/agent-role-monitor/*.test.mjs",
    "dev:local:test": "python3 scripts/dev-local-process.test.py"
  },
  "devDependencies": {
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "playwright": "1.56.1",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf",
      "esbuild"
    ]
  }
}

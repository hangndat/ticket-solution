{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Vemoki Product Surfaces Design System",
  "version": "1.0.0",
  "status": "design proposal; not merged, deployed, or feature verified",
  "inherits": "brand/vemoki/tokens.json — Live Pulse v2; marketing neon-v1 handoff",
  "foundation": {
    "color": {
      "navy950": "#060817", "navy900": "#0E1229", "navy800": "#151935", "navy700": "#24294A",
      "violet": "#9B4DFF", "magenta": "#F23CB3", "coral": "#FF835F", "blue": "#397DFF", "cyan": "#28D4EF",
      "white": "#FAF9FF", "mutedOnDark": "#C2C6DE", "subtleOnDark": "#A6AAC5",
      "paper": "#F6F8FC", "surfaceLight": "#FFFFFF", "ink": "#172039", "inkMuted": "#53607B",
      "lineLight": "#DFE5F0", "lineDark": "#363B5B",
      "admit": "#127349", "admitBg": "#E5F6ED", "deny": "#B3213A", "denyBg": "#FDE7ED",
      "warn": "#8A5800", "warnBg": "#FFF1D4", "unknown": "#6753A0", "unknownBg": "#EEE9FC",
      "focus": "#3568EF", "focusOnDark": "#B2CBFF"
    },
    "gradient": {
      "brand": "linear-gradient(105deg,#EE35B4 0%,#9944FF 48%,#3383FF 100%)",
      "highlight": "linear-gradient(100deg,#FF68AA,#FF8F6E 31%,#C870FF 63%,#777CFF)"
    },
    "typography": {"display": "Sora", "body": "Be Vietnam Pro"},
    "space": [4,8,12,16,20,24,32,40,48,64,80],
    "radius": {"sm": 10,"md": 16,"lg": 22,"xl": 28,"pill": 999},
    "touchMin": 44,
    "focusRing": {"width": 3,"offset": 3}
  },
  "surfaces": {
    "marketing": {"mode": "immersive-dark", "root": "[data-vm-surface=marketing]", "visualIntensity": "high"},
    "attendeeMobile": {"mode": "immersive-dark-chrome/light-ticket", "root": "[data-vm-surface=attendee-mobile]", "visualIntensity": "medium", "platform": "Expo React Native iOS"},
    "staffMobile": {"mode": "operational-high-contrast", "root": "[data-vm-surface=staff-mobile]", "visualIntensity": "very-low during Gate", "platform": "Expo React Native iOS", "gateAllowed": true},
    "attendeeWeb": {"mode": "calm-brand-adaptive", "root": "[data-vm-surface=attendee-web]", "visualIntensity": "low", "platform": "Next.js"},
    "portal": {"mode": "light-data-workspace/dark-navigation", "root": "[data-vm-surface=portal]", "visualIntensity": "very-low", "platform": "Next.js + Ant Design", "gateScannerAllowed": false}
  },
  "breakpointsWeb": {"small": 360,"tablet": 768,"desktop": 1024,"wide": 1440},
  "motion": {"microMs": 160,"transitionMs": 220,"decorativeMaxMs": 520,"reducedMotion": "nonessential animations removed"},
  "semanticStatus": {
    "ADMITTED": {"color": "admit", "copyVi": "Đã xác nhận vào cổng", "safeToAdmit": true},
    "DUPLICATE": {"color": "deny", "copyVi": "Vé đã được sử dụng", "safeToAdmit": false},
    "REJECTED": {"color": "deny", "copyVi": "Không hợp lệ", "safeToAdmit": false},
    "OFFLINE_QUEUED": {"color": "warn", "copyVi": "Đã xếp hàng chờ đồng bộ", "safeToAdmit": false},
    "PENDING": {"color": "warn", "copyVi": "Đang xử lý", "safeToAdmit": false},
    "CONFLICT": {"color": "deny", "copyVi": "Xung đột, cần xử lý", "safeToAdmit": false},
    "UNKNOWN": {"color": "unknown", "copyVi": "Chưa thể xác định", "safeToAdmit": false}
  }
}
